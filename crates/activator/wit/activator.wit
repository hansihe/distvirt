package distvirt:activator;

world activator {
    /// L3 flow — fabric-tracked packet correlation by (src, dst, ports, protocol) tuple.
    type packet-flow = u64;

    /// L4 stream handle — fabric-managed TCP connection with byte-stream semantics.
    type stream-handle = u64;

    enum ip-protocol {
        tcp,
        udp,
        other,
    }

    record packet-info {
        flow: packet-flow,
        src-addr: list<u8>,
        dst-addr: list<u8>,
        src-port: u16,
        dst-port: u16,
        protocol: ip-protocol,
        tcp-flags: option<u8>,
        payload: list<u8>,
        raw-frame: list<u8>,
    }

    record stream-data-event {
        s: stream-handle,
        data: list<u8>,
    }

    record upstream-connect-result-event {
        s: stream-handle,
        outcome: connect-result,
    }

    enum packet-decision {
        buffered,
        drop,
    }

    enum connect-result {
        ok,
        refused,
        timeout,
    }

    enum backend-need {
        none,
        traffic,
        active,
    }

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    record log-action {
        level: log-level,
        message: string,
    }

    variant event {
        backend-available(bool),
        tick,
        packet(packet-info),
        stream-open(stream-handle),
        stream-data(stream-data-event),
        stream-close(stream-handle),
        upstream-connect-result(upstream-connect-result-event),
        upstream-data(stream-data-event),
        upstream-close(stream-handle),
    }

    variant action {
        set-backend-need(backend-need),
        log(log-action),
        packet-decision(tuple<packet-flow, packet-decision>),
        packet-reply(tuple<packet-flow, list<u8>>),
        replay-packet(list<u8>),
        downstream-send(tuple<stream-handle, list<u8>>),
        downstream-close(stream-handle),
        pause-downstream(stream-handle),
        resume-downstream(stream-handle),
        upstream-connect(u16),
        upstream-send(tuple<stream-handle, list<u8>>),
        upstream-close(stream-handle),
        pause-upstream(stream-handle),
        resume-upstream(stream-handle),
    }

    export process-events: func(events: list<event>) -> list<action>;
}
